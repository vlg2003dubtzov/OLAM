  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Olam.Core.FieldNotebook
  lessonQuestion:
    ru: "\u041A\u0430\u043A \u0443\u0437\u043D\u0430\u0442\u044C \u0441\u043D\u0435\u0436\u043D\u043E\u0433\u043E \u0431\u0430\u0440\u0441\u0430 \u043F\u043E \u0441\u043B\u0435\u0434\u0443 \u0438 \u0447\u0442\u043E \u0440\u0430\u0441\u0442\u0451\u0442 \u0440\u044F\u0434\u043E\u043C?"
    uz: "Qor qoplonini izidan qanday bilamiz va yonida nima o\u2018sadi?"
    en: How do we recognize a snow leopard by its track, and what grows nearby?
  items:
  - id: archa_juniper
    title:
      ru: "\u0410\u0440\u0447\u0430"
      uz: Archa
      en: Juniper
    entry: {fileID: 11400000, guid: fdfa19f312aff894c9e9a145846c9161, type: 2}
    found: 0
  - id: tulip_greigii
    title:
      ru: "\u0422\u044E\u043B\u044C\u043F\u0430\u043D \u0413\u0440\u0435\u0439\u0433\u0430"
      uz: Greyg lolasii
      en: Greig's tulip
    entry: {fileID: 11400000, guid: 3b21824058867c84ca916839c033eb01, type: 2}
    found: 0
  - id: ephedra
    title:
      ru: "\u042D\u0444\u0435\u0434\u0440\u0430"
      uz: "Qirqbo\u2018g\u2018im"
      en: Ephedra
    entry: {fileID: 11400000, guid: 93edd81de7197ce4b9d99e60e73cc5ae, type: 2}
    found: 0
  - id: snow_leopard
    title:
      ru: "\u0421\u043D\u0435\u0436\u043D\u044B\u0439 \u0431\u0430\u0440\u0441 (\u043F\u043E \u0441\u043B\u0435\u0434\u0430\u043C)"
      uz: Qor qoploni
      en: Snow leopard (by tracks)
    entry: {fileID: 0}
    found: 0
