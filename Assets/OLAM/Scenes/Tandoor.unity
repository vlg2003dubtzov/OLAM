  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Olam.Core.QuestManager
  goals:
  - id: fuel
    title:
      ru: "\u041F\u043E\u043B\u043E\u0436\u0438 \u0434\u0440\u043E\u0432\u0430 \u0432 \u0442\u043E\u043F\u043A\u0443"
      uz: "Tandirga o\u2018tin sol"
      en: Put firewood into the tandoor
    required: 3
    current: 0
    done: 0
  - id: heat
    title:
      ru: "\u0420\u0430\u0437\u043E\u0433\u0440\u0435\u0439 \u0442\u0430\u043D\u0434\u044B\u0440"
      uz: Tandirni qizdir
      en: Heat up the tandoor
    required: 1
    current: 0
    done: 0
  - id: stamp
    title:
      ru: "\u041D\u0430\u043A\u043E\u043B\u0438 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0443 \u0447\u0435\u043A\u0438\u0447\u0435\u043C"
      uz: "O\u2018rtasiga chekich bos"
      en: Prick the centre with the chekich
    required: 1
    current: 0
    done: 0
  - id: wet
    title:
      ru: "\u0421\u043C\u043E\u0447\u0438 \u0442\u0435\u0441\u0442\u043E \u0432\u043E\u0434\u043E\u0439"
      uz: Xamirni suv bilan namla
      en: Moisten the dough
    required: 1
    current: 0
    done: 0
  - id: stick
    title:
      ru: "\u041F\u0440\u0438\u043B\u0435\u043F\u0438 \u043B\u0435\u043F\u0451\u0448\u043A\u0443 \u043A \u0441\u0442\u0435\u043D\u043A\u0435"
      uz: Nonni devorga yopishtir
      en: Stick the bread to the wall
    required: 1
    current: 0
    done: 0
  - id: bake_bread
    title:
      ru: "\u0414\u043E\u0436\u0434\u0438\u0441\u044C \u0440\u0443\u043C\u044F\u043D\u043E\u0439 \u043A\u043E\u0440\u043E\u0447\u043A\u0438"
      uz: Qizarguncha kut
      en: Wait for a golden crust
    required: 1
    current: 0
    done: 0
  - id: take_out
    title:
      ru: "\u0421\u043D\u0438\u043C\u0438 \u043B\u0435\u043F\u0451\u0448\u043A\u0443 \u0432\u043E\u0432\u0440\u0435\u043C\u044F"
      uz: Nonni vaqtida uz
      en: Take the bread out in time
    required: 1
    current: 0
    done: 0
  - id: serve
    title:
      ru: "\u041F\u043E\u043B\u043E\u0436\u0438 \u043B\u0435\u043F\u0451\u0448\u043A\u0443 \u043D\u0430 \u0434\u0430\u0441\u0442\u0430\u0440\u0445\u0430\u043D"
      uz: "Nonni dasturxonga qo\u2018y"
      en: Put the bread on the dastarkhan
    required: 1
    current: 0
    done: 0
