  m_text: "OLAM \xB7 \u0422\u0430\u043D\u0434\u044B\u0440\n1) \u0421\u043C\u043E\u0447\u0438 \u043B\u0435\u043F\u0451\u0448\u043A\u0443  2) \u041A\u0438\u043D\u044C \u0434\u0440\u043E\u0432\u0430 \u0432 \u0442\u043E\u043F\u043A\u0443  3) \u041F\u0440\u0438\u043B\u0435\u043F\u0438 \u043A \u0441\u0442\u0435\u043D\u043A\u0435"
