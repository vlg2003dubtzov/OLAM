  narration: {fileID: 0}
  biome: 2
  category: 0
  status: 0
  powerFact:
    ru: "\u0413\u043E\u0434\u043E\u0432\u044B\u0435 \u043A\u043E\u043B\u044C\u0446\u0430 \u0434\u043E\u043B\u0433\u043E\u0436\u0438\u0442\u0435\u043B\u044F."
    uz: Uzoq umr yillik halqalari.
    en: Ancient growth rings.
  interactHint:
    ru: "\u041F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u043A\u043E\u043B\u044C\u0446\u0430"
