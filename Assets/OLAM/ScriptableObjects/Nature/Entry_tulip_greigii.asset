  id: tulip_greigii
  title:
    ru: "\u0422\u044E\u043B\u044C\u043F\u0430\u043D \u0413\u0440\u0435\u0439\u0433\u0430"
    uz: Greyg lolasii
    en: Greig's tulip
  scientificName: Tulipa greigii
  description:
    ru: "\u041A\u043E\u0440\u043E\u043B\u044C \u0442\u044E\u043B\u044C\u043F\u0430\u043D\u043E\u0432! \u0418\u0437 \u043F\u0440\u0435\u0434\u0433\u043E\u0440\u0438\u0439 \u0422\u0430\u0448\u043A\u0435\u043D\u0442\u0430. \u0411\u043E\u043B\u044C\u0448\u043E\u0439 \u0431\u043E\u043A\u0430\u043B, \u043B\u0438\u0441\u0442\u044C\u044F \u0432 \u0431\u043E\u0440\u0434\u043E\u0432\u0443\u044E \u043A\u0440\u0430\u043F\u0438\u043D\u043A\u0443. \u041F\u0440\u0430\u0440\u043E\u0434\u0438\u0442\u0435\u043B\u044C \u0441\u043E\u0442\u0435\u043D \u0441\u043E\u0440\u0442\u043E\u0432."
    uz: "Lolalar shohi! Toshkent adirlaridan. Katta kosasi, barglarida to\u2018q qizil dog\u2018lar."
    en: King of tulips! From Tashkent foothills. Huge cup, maroon-speckled leaves; ancestor of hundreds of cultivars.
  image: {fileID: 0}
  narration: {fileID: 0}
  biome: 1
  category: 1
  status: 1
  powerFact:
    ru: "\u0418\u0437 \u0441\u0435\u043C\u0435\u0447\u043A\u0430 \u0446\u0432\u0435\u0442\u043E\u043A \u0440\u0430\u0441\u0442\u0451\u0442 7 \u043B\u0435\u0442 \u2014 \u0441\u0440\u044B\u0432\u0430\u0442\u044C \u043D\u0435\u043B\u044C\u0437\u044F!"
    uz: "Urug\u2018dan gul 7 yilda o\u2018sadi \u2014 uzmang!"
    en: "Takes 7 years from seed \u2014 never pick!"
  interactHint:
    ru: "\u0422\u043E\u043B\u044C\u043A\u043E \u0444\u043E\u0442\u043E-\u0441\u043A\u0430\u043D"
    uz: Faqat foto-skan
    en: Photo-scan only
  interactActionId: photo_only
