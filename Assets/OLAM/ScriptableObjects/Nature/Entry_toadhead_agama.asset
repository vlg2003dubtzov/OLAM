  id: toadhead_agama
  title:
    ru: "\u0423\u0448\u0430\u0441\u0442\u0430\u044F \u043A\u0440\u0443\u0433\u043B\u043E\u0433\u043E\u043B\u043E\u0432\u043A\u0430"
    uz: Quloqli yumaloqbosh
    en: Toad-headed agama
  scientificName: Phrynocephalus mystaceus
  description:
    ru: "\u041C\u0430\u0441\u0442\u0435\u0440 \u043C\u0430\u0441\u043A\u0438\u0440\u043E\u0432\u043A\u0438. \u0420\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \xAB\u0443\u0448\u0438\xBB \u0443 \u0440\u0442\u0430, \u0437\u0430\u0442\u0435\u043C \u0437\u0430 2 \u0441\u0435\u043A\u0443\u043D\u0434\u044B \u043D\u044B\u0440\u044F\u0435\u0442 \u0432 \u043F\u0435\u0441\u043E\u043A!"
    uz: "Yashirinish ustasi. Og\u2018zidagi \xABquloqlarni\xBB ochadi, 2 soniyada qumga sho\u2018ng\u2018iydi!"
    en: "Camouflage master. Flashes mouth \u201Cears\u201D, then buries itself in sand in 2 seconds!"
  image: {fileID: 0}
  narration: {fileID: 0}
  biome: 0
  category: 2
  status: 0
  powerFact:
    ru: "\u0412\u0438\u0431\u0440\u0430\u0446\u0438\u044F \u2014 \u0438 \u0438\u0441\u0447\u0435\u0437\u043B\u0430."
    uz: "Tebranadi \u2014 va yo\u2018qoladi."
    en: "Vibrates \u2014 and vanishes."
  interactHint:
    ru: "\u0421\u043F\u0440\u044F\u0442\u0430\u0442\u044C\u0441\u044F \u0432 \u043F\u0435\u0441\u043E\u043A"
    uz: Qumga yashirin
    en: Hide in sand
  interactActionId: bury
