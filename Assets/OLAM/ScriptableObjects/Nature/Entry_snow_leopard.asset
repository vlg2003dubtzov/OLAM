  category: 2
  status: 1
  powerFact:
    ru: "\u041F\u0440\u044B\u0436\u043E\u043A \u0441\u043E \u0441\u043A\u0430\u043B\u044B \u043D\u0430 \u0441\u043A\u0430\u043B\u0443."
    uz: Qoyadan qoyaga sakrash.
    en: Cliff-to-cliff leap.
  interactHint:
    ru: "\u041F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u043F\u0440\u044B\u0436\u043E\u043A"
    uz: "Sakrashni ko\u2018rsat"
    en: Show leap
